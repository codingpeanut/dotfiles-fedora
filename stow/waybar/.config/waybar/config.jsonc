{
    "layer": "top",
    "position": "top",
    "height": 34,
    "margin-top": 6,
    "margin-left": 10,
    "margin-right": 10,
    "modules-left": ["niri/workspaces", "niri/window"],
    "modules-center": ["clock"],
    "modules-right": ["pulseaudio", "network", "cpu", "memory", "battery", "tray"],

    "niri/workspaces": {
        "format": "{index}",
        "all-outputs": true
    },

    "niri/window": {
        "format": "{title}",
        "max-length": 50
    },

    "tray": {
        "spacing": 10
    },

    "clock": {
        "format": " {:%H:%M  󰃭 %Y-%m-%d}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "on-click": "gnome-calendar"
    },

    "cpu": {
        "format": " {usage}%",
        "tooltip": false,
        "on-click": "kitty --class floating_window -e btop"
    },

    "memory": {
        "format": " {}%",
        "on-click": "kitty --class floating_window -e btop"
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󱐋 {capacity}%",
        "format-plugged": " {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "on-click": "gnome-control-center power"
    },

    "network": {
        "interval": 5,
        "format-wifi": " {essid} ({signalStrength}%)",
        "format-ethernet": "󰈀 {ipaddr}",
        "tooltip-format": "󰈀 {ifname} via {gwaddr}",
        "tooltip-format-wifi": " {essid} ({signalStrength}%)\nIP: {ipaddr}\nInterface: {ifname}\n\n• 左鍵：彈出 Fuzzel Wi-Fi 選單\n• 中鍵：快速開關 Wi-Fi\n• 右鍵：開啟網路連線設定",
        "tooltip-format-disconnected": "⚠ Disconnected\n\n• 左鍵：搜尋並連線 Wi-Fi",
        "format-linked": "󰈀 {ifname} (No IP)",
        "format-disconnected": "⚠ Disconnected",
        "on-click": "~/.config/waybar/scripts/wifi-menu.sh",
        "on-click-middle": "bash -c \"nmcli radio wifi | grep -q 'enabled' && nmcli radio wifi off || nmcli radio wifi on\"",
        "on-click-right": "nm-connection-editor"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 Muted",
        "format-icons": {
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    }
}
