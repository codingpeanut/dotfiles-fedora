{
    "layer": "top",
    "position": "top",
    "height": 34,
    "margin-top": 6,
    "margin-left": 10,
    "margin-right": 10,
    "modules-left": ["niri/workspaces", "niri/window"],
    "modules-center": ["clock"],
    "modules-right": ["pulseaudio", "network", "bluetooth", "cpu", "memory", "battery"],

    "niri/workspaces": {
        "format": "{index}",
        "all-outputs": true
    },

    "niri/window": {
        "format": "{title}",
        "max-length": 50
    },

    "clock": {
        "format": " {:%H:%M  󰃭 %Y-%m-%d}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "on-click": "gnome-calendar"
    },

    "cpu": {
        "format": " {usage}%",
        "tooltip": false,
        "on-click": "kitty --class floating_window -e btop"
    },

    "memory": {
        "format": " {}%",
        "on-click": "kitty --class floating_window -e btop"
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󱐋 {capacity}%",
        "format-plugged": " {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "tooltip-format": "{timeTo}\n\n• 左鍵：開啟開關機選單 (wlogout)\n• 右鍵：開啟 GNOME 電源設定",
        "on-click": "power-menu",
        "on-click-right": "gnome-control-center power"
    },

    "network": {
        "interval": 5,
        "format-wifi": "{icon} {essid} ({signalStrength}%)",
        "format-ethernet": "󰈀 {ipaddr}",
        "tooltip-format": "󰈀 {ifname} via {gwaddr}",
        "tooltip-format-wifi": "{icon} {essid} ({signalStrength}%)\nIP: {ipaddr}\nInterface: {ifname}\n\n• 左鍵：開啟網路連線設定 (nm-connection-editor)\n• 中鍵：快速開關 Wi-Fi",
        "tooltip-format-disconnected": "󰤮 Disconnected\n\n• 左鍵：開啟網路連線設定 (nm-connection-editor)",
        "format-linked": "󰈀 {ifname} (No IP)",
        "format-disconnected": "󰤮 Disconnected",
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "on-click": "nm-connection-editor",
        "on-click-middle": "bash -c \"nmcli radio wifi | grep -q 'enabled' && nmcli radio wifi off || nmcli radio wifi on\"",
        "on-click-right": "nm-connection-editor"
    },

    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "format-on": "󰂯",
        "format-connected": "󰂱 {device_alias}",
        "format-connected-battery": "󰂱 {device_alias} ({device_battery_percentage}%)",
        "format-no-controller": "󰂲",
        "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} 個已連線裝置\n\n• 左鍵：開啟 Blueman 藍芽管理器\n• 中鍵：切換藍芽開關\n• 右鍵：開啟 Blueman 藍芽管理器",
        "tooltip-format-disabled": "藍芽已關閉\n\n• 左鍵：開啟 Blueman 管理器\n• 中鍵：開啟藍芽",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n已連線裝置:\n{device_enumerate}\n\n• 左鍵：開啟 Blueman 藍芽管理器\n• 中鍵：切換藍芽開關\n• 右鍵：開啟 Blueman 藍芽管理器",
        "tooltip-format-enumerate-connected": "• {device_alias}\t{device_address}",
        "tooltip-format-enumerate-connected-battery": "• {device_alias}\t{device_address} ({device_battery_percentage}%)",
        "on-click": "blueman-manager",
        "on-click-middle": "bash -c \"bluetoothctl show | grep -q 'Powered: yes' && bluetoothctl power off || (rfkill unblock bluetooth 2>/dev/null; bluetoothctl power on)\"",
        "on-click-right": "blueman-manager"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 Muted",
        "format-icons": {
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    }
}
