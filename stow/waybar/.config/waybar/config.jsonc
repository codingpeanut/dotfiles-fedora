{
    "layer": "top",
    "position": "top",
    "height": 34,
    "margin-top": 6,
    "margin-left": 10,
    "margin-right": 10,
    "modules-left": ["niri/workspaces", "niri/window"],
    "modules-center": ["clock"],
    "modules-right": ["pulseaudio", "network", "bluetooth", "cpu", "memory", "battery", "custom/power", "tray"],

    "niri/workspaces": {
        "format": "{index}",
        "all-outputs": true
    },

    "niri/window": {
        "format": "{title}",
        "max-length": 50
    },

    "tray": {
        "spacing": 10
    },

    "clock": {
        "format": " {:%H:%M  󰃭 %Y-%m-%d}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "on-click": "gnome-calendar"
    },

    "cpu": {
        "format": " {usage}%",
        "tooltip": false,
        "on-click": "kitty --class floating_window -e btop"
    },

    "memory": {
        "format": " {}%",
        "on-click": "kitty --class floating_window -e btop"
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󱐋 {capacity}%",
        "format-plugged": " {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "tooltip-format": "{timeTo}\n\n• 左鍵：GNOME 電源設定\n• 右鍵：關機/重啟電源選單",
        "on-click": "gnome-control-center power",
        "on-click-right": "~/.config/waybar/scripts/power-menu.sh"
    },

    "custom/power": {
        "format": "⏻",
        "tooltip-format": "電源選單 (關機、重新啟動、休眠、鎖定)\n\n• 點擊：開啟電源選單",
        "on-click": "~/.config/waybar/scripts/power-menu.sh"
    },

    "network": {
        "interval": 5,
        "format-wifi": " {essid} ({signalStrength}%)",
        "format-ethernet": "󰈀 {ipaddr}",
        "tooltip-format": "󰈀 {ifname} via {gwaddr}",
        "tooltip-format-wifi": " {essid} ({signalStrength}%)\nIP: {ipaddr}\nInterface: {ifname}\n\n• 左鍵：開啟 Wi-Fi 浮動視窗 (Mod+Q 關閉)\n• 中鍵：快速開關 Wi-Fi\n• 右鍵：開啟網路連線設定",
        "tooltip-format-disconnected": "⚠ Disconnected\n\n• 左鍵：開啟 Wi-Fi 浮動視窗",
        "format-linked": "󰈀 {ifname} (No IP)",
        "format-disconnected": "⚠ Disconnected",
        "on-click": "kitty --class floating_window --title 'Wi-Fi Manager' -e ~/.config/waybar/scripts/wifi-menu.sh",
        "on-click-middle": "bash -c \"nmcli radio wifi | grep -q 'enabled' && nmcli radio wifi off || nmcli radio wifi on\"",
        "on-click-right": "nm-connection-editor"
    },

    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "format-on": "󰂯",
        "format-connected": "󰂱 {device_alias}",
        "format-connected-battery": "󰂱 {device_alias} ({device_battery_percentage}%)",
        "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} 個已連線裝置\n\n• 左鍵：開啟 Blueman 藍芽管理器\n• 右鍵：原生 Blueman 右鍵選單\n• 中鍵：切換藍芽開關",
        "tooltip-format-disabled": "藍芽已關閉\n\n• 左鍵：開啟 Blueman 管理器\n• 中鍵：開啟藍芽",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n已連線裝置:\n{device_enumerate}\n\n• 左鍵：開啟 Blueman 藍芽管理器\n• 右鍵：原生 Blueman 右鍵選單\n• 中鍵：切換藍芽開關",
        "tooltip-format-enumerate-connected": "• {device_alias}\t{device_address}",
        "tooltip-format-enumerate-connected-battery": "• {device_alias}\t{device_address} ({device_battery_percentage}%)",
        "on-click": "blueman-manager",
        "on-click-middle": "bash -c \"bluetoothctl show | grep -q 'Powered: yes' && bluetoothctl power off || bluetoothctl power on\"",
        "on-click-right": "python3 ~/.config/waybar/scripts/blueman-menu.py"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 Muted",
        "format-icons": {
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    }
}
