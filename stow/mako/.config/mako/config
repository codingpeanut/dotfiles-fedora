# Mako notification daemon configuration
# Managed by dotfiles

font=JetBrainsMono Nerd Font 11
background-color=#1a1b26ea
text-color=#c0caf5
border-color=#7aa2f7
border-size=2
border-radius=8
padding=12
margin=10
default-timeout=5000
width=360
height=150
progress-color=over #7aa2f7

[urgency=low]
border-color=#414868
default-timeout=3000

[urgency=normal]
border-color=#7aa2f7
default-timeout=5000

[urgency=high]
border-color=#f7768e
default-timeout=0
text-color=#f7768e

max-history=50

[mode=do-not-disturb]
invisible=1
